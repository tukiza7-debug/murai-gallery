    <!-- About -->
    <string name="about_version">Version %1$s (Major Release)</string>
    <string name="about_github">github.com/tukiza7-debug/murai-gallery</string>
    <string name="about_terms_title">Terms of use</string>
    <string name="about_terms_text">Murai Gallery is provided as-is, free of charge, in the hope it is useful. You use it at your own discretion; the authors are not liable for data loss. Keep backups of what matters.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_text">Murai Gallery has no servers and no analytics. Your library never leaves the device except when you explicitly share or send it (for example to Telegram). Network access is used only for the map tiles, update checks and features you trigger yourself.</string>
    <string name="about_libraries_title">Open-source libraries</string>
    <string name="about_libraries_text">Jetpack Compose, Room, Paging, WorkManager, DataStore, Media3/ExoPlayer, Coil, osmdroid, ML Kit (text recognition), ZXing core, ExifInterface — all under their respective Apache-2.0 / BSD style licenses. This project is licensed under the Apache License 2.0.</string>

